@page "/calculator"

<PageTitle>Calculator</PageTitle>

<h1>Calculator</h1>

<div class="calculator">
    <input class="display" readonly value="@exp" />

    <div class="keys">
        <button class="key key-clear" @onclick="OnClear">C</button>
        <button class="key key-op" @onclick='() => OnOperator("^")'>^</button>
        <button class="key key-op" @onclick='() => OnOperator("%")'>%</button>
        <button class="key key-op" @onclick='() => OnOperator("/")'>/</button>

        <button class="key" @onclick='() => OnDigit("7")'>7</button>
        <button class="key" @onclick='() => OnDigit("8")'>8</button>
        <button class="key" @onclick='() => OnDigit("9")'>9</button>
        <button class="key key-op" @onclick='() => OnOperator("*")'>*</button>

        <button class="key" @onclick='() => OnDigit("4")'>4</button>
        <button class="key" @onclick='() => OnDigit("5")'>5</button>
        <button class="key" @onclick='() => OnDigit("6")'>6</button>
        <button class="key key-op" @onclick='() => OnOperator("-")'>-</button>

        <button class="key" @onclick='() => OnDigit("1")'>1</button>
        <button class="key" @onclick='() => OnDigit("2")'>2</button>
        <button class="key" @onclick='() => OnDigit("3")'>3</button>
        <button class="key key-op" @onclick='() => OnOperator("+")'>+</button>

        <button class="key zero" @onclick='() => OnDigit("0")'>0</button>
        <button class="key" @onclick="OnDecimal">.</button>
        <button class="key key-equals" @onclick="OnEquals">=</button>
    </div>
</div>

@code {
    private string exp = "";
    private readonly string[] operators = { "+", "-", "*", "/", "^", "%" };

    // Operator precedence and associativity
    private readonly Dictionary<string, (int prec, bool rightAssoc)> opInfo = new()
    {
        { "+", (1, false) },
        { "-", (1, false) },
        { "*", (2, false) },
        { "/", (2, false) },
        { "%", (2, false) },
        { "^", (3, true) }
    };
}

@functions
{
    //PEMDAS

    private void OnDigit(string d)
    {
        exp += d;
    }

    private void OnOperator(string op)
    {
        if (string.IsNullOrEmpty(exp))
        {
            // allow unary negative at start
            if (op == "-")
            {
                exp = "-";
            }
            return;
        }

        var last = exp[^1].ToString();
        if (Array.IndexOf(operators, last) >= 0)
        {
            // replace trailing operator
            exp = exp[..^1] + op;
        }
        else
        {
            exp += op;
        }
    }

    private void OnDecimal()
    {
        // Prevent multiple decimals in the current number token
        var lastNumber = GetLastNumberToken();
        if (lastNumber == null || !lastNumber.Contains("."))
        {
            // If last token is an operator or empty, prepend "0"
            if (string.IsNullOrEmpty(lastNumber))
                exp += "0.";
            else
                exp += ".";
        }
    }

    private void OnClear()
    {
        exp = "";
    }

    private void OnEquals()
    {
        if (string.IsNullOrWhiteSpace(exp))
            return;

        try
        {
            var tokens = Tokenize(exp);
            if (tokens.Count == 0)
            {
                exp = "";
                return;
            }

            var rpn = ToRpn(tokens);
            var result = EvaluateRpn(rpn);
            exp = result.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        catch
        {
            exp = "Error";
        }
    }

    // Helpers

    // Returns the last contiguous number token (or null/empty if none)
    private string? GetLastNumberToken()
    {
        if (string.IsNullOrEmpty(exp)) return null;
        int i = exp.Length - 1;
        // consume digits and '.'
        while (i >= 0 && (char.IsDigit(exp[i]) || exp[i] == '.'))
            i--;
        // allow leading minus as part of number if at start or preceded by operator
        int start = i + 1;
        if (start > 0 && exp[start] == '-' && (start == 0 || Array.IndexOf(operators, exp[start - 1].ToString()) >= 0))
        {
            // include '-' in the number
            // already covered because we only stopped at non-digit/non-dot; check previous char
        }
        var token = exp[start..];
        if (string.IsNullOrEmpty(token)) return null;
        // ensure token is numeric-ish
        return token;
    }

    private List<string> Tokenize(string s)
    {
        var tokens = new List<string>();
        int i = 0;
        bool expectNumber = true; // start expecting number to allow unary minus
        while (i < s.Length)
        {
            var c = s[i];

            if (char.IsWhiteSpace(c))
            {
                i++; continue;
            }

            // number (digits, optional leading unary minus, optional decimal)
            if (char.IsDigit(c) || (c == '-' && expectNumber) || c == '.')
            {
                int start = i;
                if (c == '-') i++; // include unary minus
                bool hasDigit = false;
                bool hasDot = false;

                while (i < s.Length && (char.IsDigit(s[i]) || s[i] == '.'))
                {
                    if (s[i] == '.')
                    {
                        if (hasDot) break; // second dot -> stop number here
                        hasDot = true;
                    }
                    else
                    {
                        hasDigit = true;
                    }
                    i++;
                }

                // If token is just "-" or just ".", treat appropriately: "-" alone as 0? We'll keep as "-" (invalid parse later)
                var num = s.Substring(start, i - start);
                tokens.Add(num);
                expectNumber = false;
                continue;
            }

            // operator
            var opStr = c.ToString();
            if (Array.IndexOf(operators, opStr) >= 0)
            {
                tokens.Add(opStr);
                i++;
                expectNumber = true;
                continue;
            }

            // unknown char -> skip
            i++;
        }

        return tokens;
    }

    private List<string> ToRpn(List<string> tokens)
    {
        var output = new List<string>();
        var stack = new Stack<string>();

        foreach (var token in tokens)
        {
            if (IsNumberToken(token))
            {
                output.Add(token);
            }
            else if (opInfo.ContainsKey(token))
            {
                var o1 = token;
                while (stack.Count > 0 && opInfo.ContainsKey(stack.Peek()))
                {
                    var o2 = stack.Peek();
                    var p1 = opInfo[o1].prec;
                    var p2 = opInfo[o2].prec;
                    var rightAssoc = opInfo[o1].rightAssoc;

                    if ((!rightAssoc && p1 <= p2) || (rightAssoc && p1 < p2))
                    {
                        output.Add(stack.Pop());
                    }
                    else
                    {
                        break;
                    }
                }
                stack.Push(o1);
            }
            else
            {
                // ignore unknown tokens
            }
        }

        while (stack.Count > 0)
            output.Add(stack.Pop());

        return output;
    }

    private double EvaluateRpn(List<string> rpn)
    {
        var st = new Stack<double>();
        foreach (var token in rpn)
        {
            if (IsNumberToken(token))
            {
                if (double.TryParse(token, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var num))
                    st.Push(num);
                else
                    throw new InvalidOperationException("Invalid number");
            }
            else
            {
                if (st.Count < 2) throw new InvalidOperationException("Invalid expression");
                var b = st.Pop();
                var a = st.Pop();
                double res = token switch
                {
                    "+" => a + b,
                    "-" => a - b,
                    "*" => a * b,
                    "/" => b == 0 ? throw new DivideByZeroException() : a / b,
                    "%" => b == 0 ? throw new DivideByZeroException() : a % b,
                    "^" => Math.Pow(a, b),
                    _ => throw new InvalidOperationException("Unknown operator")
                };
                st.Push(res);
            }
        }

        if (st.Count != 1) throw new InvalidOperationException("Invalid expression");
        return st.Pop();
    }

    private static bool IsNumberToken(string t)
    {
        if (string.IsNullOrEmpty(t)) return false;
        // allow leading '-' and decimal point
        int idx = (t[0] == '-') ? 1 : 0;
        bool hasDigit = false;
        bool hasDot = false;
        for (int i = idx; i < t.Length; i++)
        {
            if (char.IsDigit(t[i])) hasDigit = true;
            else if (t[i] == '.')
            {
                if (hasDot) return false;
                hasDot = true;
            }
            else return false;
        }
        return hasDigit;
    }
}

<style>
    .calculator {
        width: 260px;
    }

    .display {
        width: 100%;
        height: 42px;
        font-size: 1.2rem;
        text-align: right;
        padding: 6px;
        box-sizing: border-box;
        margin-bottom: 8px;
    }

    .keys {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
    }

    .key, .key-op, .key-clear, .key-equals {
        height: 48px;
        font-size: 1rem;
    }

    .zero {
        grid-column: span 2;
    }

    .key-equals {
        background: #28a745;
        color: white;
    }

    .key-op {
        background: #f0ad4e;
        color: white;
    }

    .key-clear {
        background: #d9534f;
        color: white;
    }

</style>